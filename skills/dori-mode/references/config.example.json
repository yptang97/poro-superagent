{
  "runtime": "herdr",
  "stateDir": "~/.dori/state",
  "laneWorkspace": "lanes",
  "workspaces": ["lanes"],
  "ignorePanes": [],
  "leadPane": "<your herdr pane id, from: herdr pane current>",
  "defaultCwd": "~/code/my-project",
  "agentCommand": ["omo", "--model", "{model}", "{prompt}"],
  "defaultModel": "anthropic/claude-opus-5-5",
  "launchKeywords": "ulw set goal and work",
  "goalMarker": "Pursuing goal",
  "startupWaitSeconds": 180,
  "sessionsDir": "~/.omo/agent/sessions",
  "nudgeAfterMin": 15,
  "postAfterMin": 20,
  "closeAfterMin": 5,
  "repoIdentities": {
    "my-org/my-project": {
      "name": "Your Name",
      "email": "12345+you@users.noreply.github.com"
    }
  },
  "supervision": {
    "hungAfterMinutes": 20,
    "staleAfterMinutes": 20,
    "defaults": { "wallMinutes": null, "tokens": null, "costUsd": null },
    "lanes": {},
    "activityPaths": [],
    "gitActivity": true
  },
  "heavySlots": 1,
  "heavyMaxLoad": 80,
  "deadPanePatterns": ["has stopped", "no suitable jobs"],
  "guard": {
    "loadAlert": 150,
    "loadOk": 80,
    "memFreeMinPct": 20,
    "diskFreeMinGb": 50,
    "panesMax": 20
  },
  "hooks": {
    "threadReply": ["dori", "reply", "{thread}", "--text", "{text}"],
    "threadDone": ["dori", "finish", "{thread}", "--text", "{text}"],
    "transcribe": ["my-stt", "--file", "{file}"]
  },
  "feishu": {
    "profile": "dori",
    "ownerId": "ou_your_open_id",
    "chatId": "oc_your_chat_id"
  },
  "git": {
    "repos": ["~/code/my-project"],
    "baseBranch": "main",
    "branchPrefix": "",
    "pull": true,
    "mergeMode": "no-ff",
    "testCommand": ["bun", "test"]
  }
}
